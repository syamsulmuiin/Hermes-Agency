[Unit]
Description=Provision Hermes admission lock before trusted operator sidecar
Before=hermes-operator-sidecar.service

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-tmpfiles --create /etc/tmpfiles.d/hermes-admission.conf
ExecStartPost=/usr/bin/python3 -c 'import os,stat,grp; d=os.lstat("/run/hermes-admission"); s=os.lstat("/run/hermes-admission/admission.lock"); assert stat.S_ISDIR(d.st_mode) and d.st_uid==0 and stat.S_IMODE(d.st_mode)==0o755; assert stat.S_ISREG(s.st_mode) and s.st_uid==0 and s.st_nlink==1 and stat.S_IMODE(s.st_mode)==0o640 and s.st_gid==grp.getgrnam("hermes-trusted").gr_gid'
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectSystem=strict
# /run is initially empty at boot; tmpfiles must be able to create the
# admission directory before its narrower path exists. This applies only
# to this short-lived root provisioning oneshot, not the operator sidecar.
ReadWritePaths=/run
ProtectHome=yes

[Install]
WantedBy=multi-user.target
